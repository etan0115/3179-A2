
{
  // SCHEMA: tells Vega-Lite which version (v5) of the language this file uses.
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  // DESCRIPTION: plain-English summary of the chart. Not drawn on screen.
  "description": "Proportional symbol map: annual pedestrians counted at each City of Melbourne sensor, 2025",
  // WIDTH: 'container' makes the chart as wide as its card on the page; a number is pixels.
  "width": "container",
  // HEIGHT: chart height in pixels.
  "height": 454,
  // PROJECTION: flattens longitude and latitude onto the screen.
  "projection": {"type": "mercator", "center": [144.952, -37.81], "scale": 400000},
  // LAYER: each item below is a mark stacked on the same chart. First item is at the bottom.
  "layer": [
    {
      // DATA for THIS layer (a file, or a built-in map background).
      "data": {"url": "data/melbourne_city_sa2.topojson", "format": {"type": "topojson", "feature": "sa2"}},
      // MARK (this layer): GEOSHAPE: draws map outlines (areas).
      "mark": {"type": "geoshape", "fill": "#efe9da", "stroke": "#ffffff", "strokeWidth": 1.2, "clip": true},
      // ENCODING: links data fields to visual channels for THIS layer.
      "encoding": {"tooltip": {"field": "properties.SA2_NAME21", "title": "Area"}}
    },
    {
      // DATA for THIS layer (a file, or a built-in map background).
      "data": {
        // URL: path to the data file.
        "url": "data/melbourne_sensor_totals_2025.csv",
        // FORMAT: how to read the file.
        "format": {"type": "csv", "parse": {"Location_ID": "number", "total_2025": "number"}}
      },
      // TRANSFORM: extra data-prep steps that apply to THIS layer only.
      "transform": [
        {
          // LOOKUP: joins a second table (here a file or list) by a shared key. The value on this line is the key in THIS data.
          "lookup": "Location_ID",
          // FROM: the second table used for the join.
          "from": {
            // SECOND TABLE: the file joined in by the lookup.
            "data": {"url": "data/melbourne_sensor_locations.csv"},
            "key": "Location_ID",
            "fields": ["Sensor_Location_Full_Name", "Latitude", "Longitude"]
          }
        },
        // FILTER: keeps only the rows where this expression is true.
        {"filter": "isValid(datum.Latitude)"},
        // WINDOW: calculates across ordered rows (rank, running total).
        {"window": [{"op": "row_number", "as": "rank"}], "sort": [{"field": "total_2025", "order": "descending"}]}
      ],
      // LAYER: each item below is a mark stacked on the same chart. First item is at the bottom.
      "layer": [
        {
          // PARAMS: an interactive control or a selection that other parts of this file can read.
          "params": [{"name": "hover", "select": {"type": "point", "on": "pointerover", "clear": "pointerout"}}],
          // MARK (this layer): CIRCLE: a filled dot.
          "mark": {"type": "circle", "color": "#0f5c5e", "opacity": 0.55, "clip": true},
          // ENCODING: links data fields to visual channels for THIS layer.
          "encoding": {
            // LONGITUDE channel: map position, east to west. Uses field 'Longitude'.
            "longitude": {"field": "Longitude", "type": "quantitative"},
            // LATITUDE channel: map position, north to south. Uses field 'Latitude'.
            "latitude": {"field": "Latitude", "type": "quantitative"},
            // SIZE channel: area of the mark. Uses field 'total_2025'.
            "size": {
              "field": "total_2025",
              "type": "quantitative",
              "title": "Pedestrians in 2025",
              // SCALE: how data values map to the channel.
              "scale": {"domain": [0, 14200000], "range": [0, 1200]},
              // LEGEND: key explaining the colours or sizes.
              "legend": {"orient": "top", "format": "~s", "labelExpr": "datum.value >= 1000000 ? format(datum.value / 1000000, '~') + ' million' : format(datum.value / 1000, '~') + ' thousand'", "values": [1000000, 5000000, 10000000], "direction": "horizontal"}
            },
            // ORDER channel: drawing order (higher draws on top). Uses field 'total_2025'.
            "order": {"field": "total_2025", "sort": "descending"},
            // TOOLTIP: text shown when you hover (details on demand). Uses field 'Sensor_Location_Full_Name'.
            "tooltip": [
              {"field": "Sensor_Location_Full_Name", "title": "Sensor location"},
              {"field": "total_2025", "type": "quantitative", "format": ",", "title": "Pedestrians in 2025"},
              {"field": "rank", "title": "Rank (out of 100 sensors)"}
            ],
            // STROKE channel: outline colour. Uses value '#1f2e22'.
            "stroke": {"condition": {"param": "hover", "empty": false, "value": "#1f2e22"}, "value": "#ffffff"},
            // STROKE WIDTH channel: outline thickness. Uses value '2'.
            "strokeWidth": {"condition": {"param": "hover", "empty": false, "value": 2}, "value": 0.8}
          }
        },
        {
          // TRANSFORM: extra data-prep steps that apply to THIS layer only.
          "transform": [{"filter": "datum.rank == 1"}],
          // MARK (this layer): CIRCLE: a filled dot.
          "mark": {"type": "circle", "opacity": 0.7, "stroke": "#1f2e22", "strokeWidth": 1.5},
          // ENCODING: links data fields to visual channels for THIS layer.
          "encoding": {
            // SIZE channel: area of the mark. Uses field 'total_2025'.
            "size": {"field": "total_2025", "type": "quantitative"},
            // LONGITUDE channel: map position, east to west. Uses field 'Longitude'.
            "longitude": {"field": "Longitude", "type": "quantitative"},
            // LATITUDE channel: map position, north to south. Uses field 'Latitude'.
            "latitude": {"field": "Latitude", "type": "quantitative"},
            // COLOUR channel: hue or shade. Uses datum 'Busiest sensor: Flinders Lane and Swanston Street'.
            "color": {
              "datum": "Busiest sensor: Flinders Lane and Swanston Street, 14.1 million",
              "type": "nominal",
              // SCALE: how data values map to the channel.
              "scale": {"range": ["#ad8a4e"]},
              // LEGEND: key explaining the colours or sizes.
              "legend": {
                "orient": "top",
                "title": null,
                "symbolType": "circle",
                "symbolSize": 180,
                "symbolStrokeColor": "#1f2e22",
                "symbolStrokeWidth": 1.5,
                "labelLimit": 320,
                "labelFontSize": 11.5,
                // LABEL EXPRESSION: formula that writes each axis or legend label.
                "labelExpr": "['Busiest sensor: Flinders Lane', 'and Swanston Street, 14.1 million']",
                "symbolOpacity": 0.7
              }
            }
          }
        }
      ]
    }
  ],
  // CONFIG: styling only (fonts, colours, gridlines). It changes how the chart looks, never what it says.
  "config": {
    // BACKGROUND: transparent, so the card colour shows through.
    "background": "transparent",
    // FONT used everywhere.
    "font": "IBM Plex Sans",
    // VIEW: removes the box border around the plot (less ink).
    "view": {"stroke": null},
    // LEGEND style for every legend.
    "legend": {
      "labelColor": "#5b6058",
      "titleColor": "#1f2e22",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleLimit": 300
    },
    // TEXT style for text marks.
    "text": {"font": "IBM Plex Sans"}
  }
}
