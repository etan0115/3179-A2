{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Radial charts: average pedestrians per sensor for each hour of the day, weekdays vs weekends, City of Melbourne 2025",
  "data": {
    "url": "data/melbourne_weekday_hour_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "hour": "number",
        "total_count": "number",
        "sensor_hours": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof(['Saturday','Sunday'], datum.weekday) >= 0 ? 'Weekends' : 'Weekdays'",
      "as": "day_type"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "total_count",
          "as": "total"
        },
        {
          "op": "sum",
          "field": "sensor_hours",
          "as": "hours"
        }
      ],
      "groupby": [
        "day_type",
        "hour"
      ]
    },
    {
      "calculate": "datum.total / datum.hours",
      "as": "avg_per_sensor"
    },
    {
      "calculate": "datum.hour == 0 ? '12am' : datum.hour < 12 ? datum.hour + 'am' : datum.hour == 12 ? '12pm' : (datum.hour - 12) + 'pm'",
      "as": "hour_label"
    },
    {
      "calculate": "datum.hour + 1",
      "as": "hour_end"
    },
    {
      "calculate": "(datum.day_type == 'Weekdays' && (datum.hour == 12 || datum.hour == 17)) || (datum.day_type == 'Weekends' && datum.hour == 14) ? 'Peak hour' : 'Other hours'",
      "as": "hour_type"
    }
  ],
  "facet": {
    "column": {
      "field": "day_type",
      "type": "nominal",
      "title": null,
      "sort": [
        "Weekdays",
        "Weekends"
      ],
      "header": {
        "labelFontSize": 14,
        "labelFontWeight": 600,
        "labelColor": "#1f2e22"
      }
    }
  },
  "spec": {
    "width": 240,
    "height": 320,
    "layer": [
      {
        "mark": {
          "type": "arc",
          "innerRadius": 16,
          "padAngle": 0.02,
          "cornerRadius": 2
        },
        "encoding": {
          "radius": {
            "field": "avg_per_sensor",
            "type": "quantitative",
            "scale": {
              "type": "sqrt",
              "zero": true,
              "rangeMin": 16,
              "rangeMax": 108
            }
          },
          "tooltip": [
            {
              "field": "day_type",
              "title": "Type of day"
            },
            {
              "field": "hour_label",
              "title": "Hour starting"
            },
            {
              "field": "hour_type",
              "title": "Hour type"
            },
            {
              "field": "avg_per_sensor",
              "type": "quantitative",
              "format": ",.0f",
              "title": "Average pedestrians per sensor"
            }
          ],
          "theta": {
            "field": "hour",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                24
              ],
              "range": [
                0,
                6.2832
              ]
            }
          },
          "theta2": {
            "field": "hour_end"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 0.5
          },
          "color": {
            "field": "hour_type",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": [
                "Peak hour",
                "Other hours"
              ],
              "range": [
                "#c9a25a",
                "#9fb8b0"
              ]
            },
            "legend": {
              "orient": "top",
              "direction": "horizontal",
              "symbolType": "square",
              "labelFontSize": 12
            }
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.hour % 3 == 0"
          }
        ],
        "mark": {
          "type": "text",
          "radius": 122,
          "fontSize": 11,
          "color": "#5b6058",
          "align": "center",
          "baseline": "middle"
        },
        "encoding": {
          "text": {
            "field": "hour_label"
          },
          "theta": {
            "field": "hour",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                24
              ],
              "range": [
                0,
                6.2832
              ]
            }
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.hour == 12"
          },
          {
            "calculate": "datum.day_type == 'Weekdays' ? ['Two peaks:', 'lunchtime (12pm) and evening (5pm)'] : ['One long afternoon:', 'busiest at 2pm']",
            "as": "note"
          }
        ],
        "mark": {
          "type": "text",
          "radius": 150,
          "fontSize": 11,
          "fontWeight": 600,
          "color": "#1f2e22",
          "align": "center",
          "baseline": "top",
          "lineHeight": 14
        },
        "encoding": {
          "theta": {
            "datum": 12,
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                24
              ],
              "range": [
                0,
                6.2832
              ]
            }
          },
          "text": {
            "field": "note"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "radius": "shared"
    }
  },
  "config": {
    "background": "transparent",
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 30
    },
    "text": {
      "font": "IBM Plex Sans"
    }
  }
}
