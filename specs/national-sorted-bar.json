{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Box plot: share of employed people who walked to work across Victoria's 66 statistical regions, by region type (Census 2021)",
  "width": "container",
  "height": {"step": 100},
  "data": {
    "url": "data/census2021_G62_travel_to_work_vic_sa3.csv",
    "format": {
      "type": "csv",
      "parse": {"SA3_CODE_2021": "string", "Tot_P": "number", "One_method_Walked_only_P": "number"}
    }
  },
  "transform": [
    {"calculate": "toString(datum.SA3_CODE_2021)", "as": "sa3_code"},
    {"filter": "substring(datum.sa3_code, 0, 2) != '29'"},
    {"calculate": "substring(datum.sa3_code, 0, 3)", "as": "sa4"},
    {
      "calculate": "indexof(['206','207','208'], datum.sa4) >= 0 ? 'Inner Melbourne' : indexof(['209','210','211','212','213','214'], datum.sa4) >= 0 ? 'Middle & outer Melbourne' : 'Regional Victoria'",
      "as": "region_group"
    },
    {
      "lookup": "sa3_code",
      "from": {
        "data": {"url": "data/victoria_sa3_2021.topojson", "format": {"type": "topojson", "feature": "sa3"}},
        "key": "properties.SA3_CODE_2021"
      },
      "as": "geo"
    },
    {"calculate": "datum.geo.properties.SA3_NAME_2021", "as": "sa3_name"},
    {"calculate": "datum.One_method_Walked_only_P / datum.Tot_P * 100", "as": "walked_pct"},
    {"calculate": "(toNumber(datum.sa3_code) % 13) / 13 - 0.5", "as": "jitter"}
  ],
  "encoding": {
    "y": {
      "field": "region_group",
      "type": "nominal",
      "title": null,
      "sort": ["Inner Melbourne", "Middle & outer Melbourne", "Regional Victoria"],
      "axis": {"labelFontSize": 12, "labelLimit": 240},
      "scale": {"paddingInner": 0, "paddingOuter": 0}
    },
    "x": {"field": "walked_pct", "type": "quantitative", "title": "Walked to work (%)", "scale": {"domain": [0, 13]}}
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": 1.5,
        "size": 38,
        "outliers": false,
        "median": {"color": "#1f2e22", "strokeWidth": 2},
        "box": {"opacity": 0.35},
        "rule": {"color": "#8b8f83"},
        "ticks": false
      },
      "encoding": {
        "color": {
          "field": "region_group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["Inner Melbourne", "Middle & outer Melbourne", "Regional Victoria"],
            "range": ["#7b5c8f", "#5f6b73", "#b5566b"]
          }
        }
      }
    },
    {
      "mark": {"type": "circle", "size": 40, "opacity": 0.85, "stroke": "#ffffff", "strokeWidth": 0.8},
      "encoding": {
        "yOffset": {"field": "jitter", "type": "quantitative", "scale": {"domain": [-0.5, 0.5], "range": [34, 66]}},
        "color": {"field": "region_group", "type": "nominal", "legend": null},
        "tooltip": [
          {"field": "sa3_name", "title": "Region"},
          {"field": "region_group", "title": "Region type"},
          {"field": "walked_pct", "type": "quantitative", "format": ".1f", "title": "Walked to work (%)"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.sa3_name == 'Melbourne City'"}],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "dy": -12,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1f2e22"
      },
      "encoding": {
        "text": {"value": "Melbourne City 12.1%"},
        "yOffset": {"field": "jitter", "type": "quantitative", "scale": {"domain": [-0.5, 0.5], "range": [34, 66]}}
      }
    }
  ],
  "config": {
    "font": "IBM Plex Sans",
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#5b6058",
      "titleColor": "#1f2e22",
      "gridColor": "#ece8dd",
      "domainColor": "#c9c3b3",
      "tickColor": "#c9c3b3"
    },
    "text": {"font": "IBM Plex Sans"}
  }
}