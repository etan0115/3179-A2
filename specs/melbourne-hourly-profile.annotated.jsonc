              6,
              9,
              12,
              15,
              18,
              21
            ],
            // LABEL EXPRESSION: formula that writes each axis or legend label.
            "labelExpr": "datum.value == 0 ? '12am' : datum.value < 12 ? datum.value + 'am' : datum.value == 12 ? '12pm' : (datum.value - 12) + 'pm'",
            "labelAngle": 0,
            "grid": false
          }
        },
        // Y channel: vertical POSITION. Uses field 'avg_per_sensor'.
        "y": {
          "field": "avg_per_sensor",
          "type": "quantitative",
          "title": "Average pedestrians per sensor, per hour",
          // SCALE: how data values map to the channel.
          "scale": {
            // DOMAIN: the data range (or class breaks) on this scale.
            "domain": [
              0,
              1000
            ],
            "nice": false
          },
          // AXIS: tick labels, format and title for this channel.
          "axis": {
            "tickCount": 5,
            "format": ",",
            // LABEL EXPRESSION: formula that writes each axis or legend label.
            "labelExpr": "format(datum.value, ',.0f')"
          }
        },
        // TEXT channel: the words drawn. Uses value 'Weekend peak'.
        "text": {
          "value": "Weekend peak, 2pm"
