{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle charts: how employed people travelled to work on Census day 2021, by state. Each square is 1% of workers.",
  "data": {
    "url": "data/census2021_travel_to_work_by_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "New South Wales": "number",
        "Victoria": "number",
        "Queensland": "number",
        "South Australia": "number",
        "Western Australia": "number",
        "Tasmania": "number",
        "Northern Territory": "number",
        "Australian Capital Territory": "number",
        "Australia": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.Mode != 'Total'"
    },
    {
      "fold": [
        "Australia",
        "New South Wales",
        "Victoria",
        "Queensland",
        "South Australia",
        "Western Australia",
        "Tasmania",
        "Northern Territory",
        "Australian Capital Territory"
      ],
      "as": [
        "state",
        "people"
      ]
    },
    {
      "calculate": "datum.Mode == 'Walked only' ? 'Walked' : datum.Mode == 'Bicycle' ? 'Cycled' : indexof(['Train','Bus','Ferry','Tram/light rail'], datum.Mode) >= 0 ? 'Public transport' : indexof(['Car, as driver','Car, as passenger','Taxi/ride-share service'], datum.Mode) >= 0 ? 'Car' : datum.Mode == 'Worked at home' ? 'Worked at home' : datum.Mode == 'Did not go to work' ? 'Did not go to work' : 'Other or not stated'",
      "as": "mode_group"
    },
    {
      "calculate": "indexof(['Walked','Cycled','Public transport','Car','Other or not stated','Worked at home','Did not go to work'], datum.mode_group)",
      "as": "mode_order"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "people",
          "as": "people"
        }
      ],
      "groupby": [
        "state",
        "mode_group",
        "mode_order"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "people",
          "as": "state_total"
        }
      ],
      "groupby": [
        "state"
      ]
    },
    {
      "calculate": "datum.people / datum.state_total",
      "as": "share"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "share",
          "as": "cum_end"
        }
      ],
      "groupby": [
        "state"
      ],
      "sort": [
        {
          "field": "mode_order"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "round((datum.cum_end - datum.share) * 100)",
      "as": "first_square"
    },
    {
      "calculate": "round(datum.cum_end * 100)",
      "as": "end_square"
    },
    {
      "calculate": "sequence(datum.first_square, datum.end_square)",
      "as": "square"
    },
    {
      "flatten": [
        "square"
      ]
    },
    {
      "filter": "isValid(datum.square)"
    },
    {
      "calculate": "datum.square % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.square / 10)",
      "as": "row"
    }
  ],
  "facet": {
    "field": "state",
    "type": "nominal",
    "title": null,
    "sort": [
      "Australia",
      "New South Wales",
      "Victoria",
      "Australian Capital Territory",
      "Queensland",
      "South Australia",
      "Western Australia",
      "Tasmania",
      "Northern Territory"
    ],
    "header": {
      "labelFontSize": 12,
      "labelFontWeight": 600,
      "labelColor": "#1f2e22",
      "labelPadding": 6,
      "labelExpr": "datum.value == 'Australian Capital Territory' ? ['Australian Capital', 'Territory'] : datum.value",
      "labelLimit": 160
    }
  },
  "columns": 3,
  "spec": {
    "width": 140,
    "height": 140,
    "layer": [
      {
        "params": [
          {
            "name": "mode_pick",
            "select": {
              "type": "point",
              "fields": [
                "mode_group"
              ]
            },
            "bind": "legend"
          }
        ],
        "mark": {
          "type": "rect",
          "cornerRadius": 2
        },
        "encoding": {
          "x": {
            "field": "col",
            "type": "ordinal",
            "axis": null,
            "scale": {
              "paddingInner": 0.15
            }
          },
          "y": {
            "field": "row",
            "type": "ordinal",
            "axis": null,
            "scale": {
              "paddingInner": 0.15
            }
          },
          "color": {
            "field": "mode_group",
            "type": "nominal",
            "title": "How they got to work",
            "sort": [
              "Walked",
              "Cycled",
              "Public transport",
              "Car",
              "Other or not stated",
              "Worked at home",
              "Did not go to work"
            ],
            "scale": {
              "domain": [
                "Walked",
                "Cycled",
                "Public transport",
                "Car",
                "Other or not stated",
                "Worked at home",
                "Did not go to work"
              ],
              "range": [
                "#0f5c5e",
                "#8a9a4f",
                "#4c6e96",
                "#5f5a52",
                "#c8c3b6",
                "#be6e33",
                "#e3b58c"
              ]
            },
            "legend": {
              "orient": "top",
              "columns": 2,
              "columnPadding": 14,
              "symbolType": "square",
              "labelFontSize": 12,
              "offset": 12
            }
          },
          "opacity": {
            "condition": {
              "param": "mode_pick",
              "value": 1
            },
            "value": 0.15
          },
          "tooltip": [
            {
              "field": "state",
              "title": "State or territory"
            },
            {
              "field": "mode_group",
              "title": "Travel method"
            },
            {
              "field": "share",
              "type": "quantitative",
              "format": ".1%",
              "title": "Share of workers"
            },
            {
              "field": "people",
              "type": "quantitative",
              "format": ",",
              "title": "People"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum.mode_group == 'Walked' && datum.square == datum.first_square"
          },
          {
            "calculate": "datum.state == 'Australia' ? [\"Cars carry 57% of workers;\", \"walking only 2.5%\"] : datum.state == 'New South Wales' ? [\"Lockdown: 31% of workers\", \"worked at home\"] : datum.state == 'Victoria' ? [\"Lockdown: 26% of workers\", \"worked at home\"] : datum.state == 'Tasmania' ? [\"Second-highest walking\", \"share: 4.2%\"] : datum.state == 'Northern Territory' ? [\"Highest walking share:\", \"7.6% of workers\"] : datum.state == 'Australian Capital Territory' ? [\"Walking 4.0%, well above\",\"the national 2.5%\"] : datum.state == 'Queensland' ? [\"Cars carry 65%\",\"of workers\"] : datum.state == 'South Australia' ? [\"Cars carry 69%\",\"of workers\"] : datum.state == 'Western Australia' ? [\"Highest public transport\",\"share: 7.4%\"] : null",
            "as": "note"
          },
          {
            "filter": "isValid(datum.note)"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "fontSize": 11,
          "fontWeight": 600,
          "color": "#1f2e22",
          "lineHeight": 14,
          "dy": 0
        },
        "encoding": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 148
          },
          "text": {
            "field": "note"
          }
        }
      }
    ]
  },
  "config": {
    "background": "transparent",
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 20
    },
    "legend": {
      "labelColor": "#5b6058",
      "titleColor": "#1f2e22",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelLimit": 200,
      "titleLimit": 250
    },
    "text": {
      "font": "IBM Plex Sans"
    }
  },
  "spacing": {
    "row": 18,
    "column": 20
  }
}
