
{
  // SCHEMA: tells Vega-Lite which version (v5) of the language this file uses.
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  // DESCRIPTION: plain-English summary of the chart. Not drawn on screen.
  "description": "Recreational walking participation by age group",
  // WIDTH: 'container' makes the chart as wide as its card on the page; a number is pixels.
  "width": "container",
  // HEIGHT: chart height in pixels.
  "height": 304,
  // DATA: which file to read.
  "data": {
    // URL: path to the data file.
    "url": "data/ausplay_participation_2025.csv",
    // FORMAT: how to read the file.
    "format": {
      "type": "csv",
      "parse": {
        "rate_Total": "number",
        "rate_Male": "number",
        "rate_Female": "number",
        "rate_15-17": "number",
        "rate_18-24": "number",
        "rate_25-34": "number",
        "rate_35-44": "number",
        "rate_45-54": "number",
        "rate_55-64": "number",
        "rate_65+": "number",
        "participants_Total": "number",
        "participants_Male": "number",
        "participants_Female": "number",
        "participants_15-17": "number",
        "participants_18-24": "number",
        "participants_25-34": "number",
        "participants_35-44": "number",
        "participants_45-54": "number",
        "participants_55-64": "number",
        "participants_65+": "number"
      }
    }
  },
  // TRANSFORM: data-prep steps. They run TOP TO BOTTOM; each step feeds the next.
  "transform": [
    // FILTER: keeps only the rows where this expression is true.
    {"filter": "datum.activity == 'Walking (Recreational)'"},
    {
      // FOLD: turns several columns into rows (wide to long).
      "fold": ["rate_15-17", "rate_18-24", "rate_25-34", "rate_35-44", "rate_45-54", "rate_55-64", "rate_65+"],
      "as": ["column", "rate"]
    },
    // CALCULATE: makes the new column "age_group" from this formula.
    {"calculate": "replace(datum.column, 'rate_', '')", "as": "age_group"},
    // CALCULATE: makes the new column "age_group_label" from this formula.
    {"calculate": "replace(replace(datum.age_group, '-', ' to '), '+', ' and over')", "as": "age_group_label"}
  ],
  // ENCODING: links data fields to visual channels (position, colour, size...) for ALL layers below.
  "encoding": {
    // X channel: horizontal POSITION. Uses field 'age_group'.
    "x": {
      "field": "age_group",
      "type": "ordinal",
      // SORT: order of the categories.
      "sort": ["15-17", "18-24", "25-34", "35-44", "45-54", "55-64", "65+"],
      "title": "Age group",
      // AXIS: tick labels, format and title for this channel.
      "axis": {"labelAngle": 0}
    },
    // Y channel: vertical POSITION. Uses field 'rate'.
    "y": {
      "field": "rate",
      "type": "quantitative",
      "title": "Walk for recreation",
      // SCALE: how data values map to the channel.
      "scale": {"domain": [0, 0.8]},
      // AXIS: tick labels, format and title for this channel.
      "axis": {"format": "%", "tickCount": 5}
    }
  },
  // LAYER: each item below is a mark stacked on the same chart. First item is at the bottom.
  "layer": [
    // MARK (this layer): LINE: joins points in order.
    {"mark": {"type": "line", "color": "#0f5c5e", "strokeWidth": 2.5}},
    {
      // MARK (this layer): POINT: a dot or symbol.
      "mark": {"type": "point", "filled": true, "size": 60},
      // ENCODING: links data fields to visual channels for THIS layer.
      "encoding": {
        // TOOLTIP: text shown when you hover (details on demand). Uses field 'age_group_label'.
        "tooltip": [
          {"field": "age_group_label", "title": "Age group"},
          {"field": "rate", "type": "quantitative", "format": ".1%", "title": "Walk for recreation"}
        ],
        // COLOUR channel: hue or shade. Uses value '#ad8a4e'.
        "color": {"condition": {"test": "datum.age_group == '55-64'", "value": "#ad8a4e"}, "value": "#0f5c5e"},
        // SIZE channel: area of the mark. Uses value '110'.
        "size": {"condition": {"test": "datum.age_group == '55-64'", "value": 110}, "value": 60}
      }
    },
    {
      // TRANSFORM: extra data-prep steps that apply to THIS layer only.
      "transform": [{"filter": "datum.age_group == '55-64'"}],
      // MARK (this layer): TEXT: draws words (labels and annotations).
      "mark": {"type": "text", "dy": -16, "fontSize": 11, "fontWeight": 500, "color": "#1f2e22"},
      // ENCODING: links data fields to visual channels for THIS layer.
      "encoding": {"text": {"value": "Peak: 66% of 55–64 year olds"}}
    }
  ],
  // CONFIG: styling only (fonts, colours, gridlines). It changes how the chart looks, never what it says.
  "config": {
    // BACKGROUND: transparent, so the card colour shows through.
    "background": "transparent",
    // FONT used everywhere.
    "font": "IBM Plex Sans",
    // VIEW: removes the box border around the plot (less ink).
    "view": {"stroke": null},
    // AXIS style for every axis.
    "axis": {
      "labelColor": "#5b6058",
      "titleColor": "#1f2e22",
      "gridColor": "#ece8dd",
      "domainColor": "#c9c3b3",
      "tickColor": "#c9c3b3",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 500
    },
    // LEGEND style for every legend.
    "legend": {
      "labelColor": "#5b6058",
      "titleColor": "#1f2e22",
      "titleLimit": 320,
      "labelLimit": 260,
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 500
    },
    // TEXT style for text marks.
    "text": {"font": "IBM Plex Sans", "color": "#1f2e22"}
  }
}
