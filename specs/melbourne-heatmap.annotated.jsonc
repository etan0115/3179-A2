
{
  // SCHEMA: tells Vega-Lite which version (v5) of the language this file uses.
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  // DESCRIPTION: plain-English summary of the chart. Not drawn on screen.
  "description": "Heatmap: average pedestrians per sensor per hour, by day of week and hour of day (2025)",
  // WIDTH: 'container' makes the chart as wide as its card on the page; a number is pixels.
  "width": "container",
  // HEIGHT: chart height in pixels.
  "height": 400,
  // DATA: which file to read.
  "data": {
    // URL: path to the data file.
    "url": "data/melbourne_weekday_hour_2025.csv",
    // FORMAT: how to read the file.
    "format": {"type": "csv", "parse": {"hour": "number", "total_count": "number", "sensor_hours": "number"}}
  },
  // TRANSFORM: data-prep steps. They run TOP TO BOTTOM; each step feeds the next.
  "transform": [
    // CALCULATE: makes the new column "avg_per_sensor" from this formula.
    {"calculate": "datum.total_count / datum.sensor_hours", "as": "avg_per_sensor"},
    {
      // CALCULATE: makes the new column "hour_label" from this formula.
      "calculate": "datum.hour == 0 ? '12am' : datum.hour < 12 ? datum.hour + 'am' : datum.hour == 12 ? '12pm' : (datum.hour - 12) + 'pm'",
      "as": "hour_label"
    }
  ],
  // CONFIG: styling only (fonts, colours, gridlines). It changes how the chart looks, never what it says.
  "config": {
    // BACKGROUND: transparent, so the card colour shows through.
    "background": "transparent",
    // FONT used everywhere.
    "font": "IBM Plex Sans",
    // VIEW: removes the box border around the plot (less ink).
    "view": {"stroke": null},
    // AXIS style for every axis.
    "axis": {
      "labelColor": "#5b6058",
      "titleColor": "#1f2e22",
      "gridColor": "#ece8dd",
      "domainColor": "#c9c3b3",
      "tickColor": "#c9c3b3",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 500
    },
    // LEGEND style for every legend.
    "legend": {
      "labelColor": "#5b6058",
      "titleColor": "#1f2e22",
      "titleLimit": 320,
      "labelLimit": 260,
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 500
    },
    // TEXT style for text marks.
    "text": {"font": "IBM Plex Sans", "color": "#1f2e22"}
  },
  // LAYER: each item below is a mark stacked on the same chart. First item is at the bottom.
  "layer": [
    {
      // MARK (this layer): RECT: draws a rectangle for each row (cells, squares, boxes).
      "mark": {"type": "rect", "stroke": "#ffffff", "strokeWidth": 1},
      // ENCODING: links data fields to visual channels for THIS layer.
      "encoding": {
        // X channel: horizontal POSITION. Uses field 'hour'.
        "x": {
          "field": "hour",
          "type": "ordinal",
          "title": "Hour of day",
          // AXIS: tick labels, format and title for this channel.
          "axis": {
            "labelAngle": 0,
            // LABEL EXPRESSION: formula that writes each axis or legend label.
            "labelExpr": "datum.value % 3 == 0 ? (datum.value == 0 ? '12am' : datum.value < 12 ? datum.value + 'am' : datum.value == 12 ? '12pm' : (datum.value - 12) + 'pm') : ''"
          }
        },
        // Y channel: vertical POSITION. Uses field 'weekday'.
        "y": {
          "field": "weekday",
          "type": "ordinal",
          // SORT: order of the categories.
          "sort": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "title": null
        },
        // COLOUR channel: hue or shade. Uses field 'avg_per_sensor'.
        "color": {
          "field": "avg_per_sensor",
          "type": "quantitative",
          "title": "Average pedestrians per sensor, per hour",
          // SCALE: how data values map to the channel.
          "scale": {"range": ["#f3efe4", "#5c9a86", "#0f5c5e", "#08393a"]},
          // LEGEND: key explaining the colours or sizes.
          "legend": {"orient": "top", "direction": "horizontal", "gradientLength": 220, "offset": 32}
        },
        // TOOLTIP: text shown when you hover (details on demand). Uses field 'weekday'.
        "tooltip": [
          {"field": "weekday", "title": "Day of the week"},
          {"field": "hour_label", "title": "Hour starting"},
          {
            "field": "avg_per_sensor",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Average pedestrians per sensor"
          }
        ]
      }
    },
    {
      // TRANSFORM: extra data-prep steps that apply to THIS layer only.
      "transform": [{"filter": "datum.hour == 17 && indexof(['Saturday','Sunday'], datum.weekday) < 0"}],
      // MARK (this layer): RECT: draws a rectangle for each row (cells, squares, boxes).
      "mark": {"type": "rect", "fill": null, "stroke": "#ad8a4e", "strokeWidth": 2},
      // ENCODING: links data fields to visual channels for THIS layer.
      "encoding": {
        // X channel: horizontal POSITION. Uses field 'hour'.
        "x": {
          "field": "hour",
          "type": "ordinal",
          "title": "Hour of day",
          // AXIS: tick labels, format and title for this channel.
          "axis": {
            "labelAngle": 0,
            // LABEL EXPRESSION: formula that writes each axis or legend label.
            "labelExpr": "datum.value % 3 == 0 ? (datum.value == 0 ? '12am' : datum.value < 12 ? datum.value + 'am' : datum.value == 12 ? '12pm' : (datum.value - 12) + 'pm') : ''"
          }
        },
        // Y channel: vertical POSITION. Uses field 'weekday'.
        "y": {
          "field": "weekday",
          "type": "ordinal",
          // SORT: order of the categories.
          "sort": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "title": null
        }
      }
    },
    {
      // TRANSFORM: extra data-prep steps that apply to THIS layer only.
      "transform": [{"filter": "datum.hour == 17 && datum.weekday == 'Monday'"}],
      // MARK (this layer): TEXT: draws words (labels and annotations).
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -4,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1f2e22",
        "align": "right",
        "dx": -4
      },
      // ENCODING: links data fields to visual channels for THIS layer.
      "encoding": {
        // X channel: horizontal POSITION. Uses field 'hour'.
        "x": {
          "field": "hour",
          "type": "ordinal",
          "title": "Hour of day",
          // AXIS: tick labels, format and title for this channel.
          "axis": {
            "labelAngle": 0,
            // LABEL EXPRESSION: formula that writes each axis or legend label.
            "labelExpr": "datum.value % 3 == 0 ? (datum.value == 0 ? '12am' : datum.value < 12 ? datum.value + 'am' : datum.value == 12 ? '12pm' : (datum.value - 12) + 'pm') : ''"
          }
        },
        // Y channel: vertical POSITION. Uses field 'weekday'.
        "y": {
          "field": "weekday",
          "type": "ordinal",
          // SORT: order of the categories.
          "sort": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "title": null,
          "bandPosition": 0
        },
        // TEXT channel: the words drawn. Uses value 'Weekday evening rush (5pm)'.
        "text": {"value": "Weekday evening rush (5pm)"}
      }
    }
  ]
}
